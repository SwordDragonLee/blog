# 复制为同目录 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 键名规则 = config.yaml 配置项点号换下划线并全大写：llm.api_key → LLM_API_KEY
# 进程已设置的环境变量优先级高于 .env（容器部署时由 compose env_file 注入）

MYSQL_PASSWORD=MySQL 密码
RABBITMQ_URL=amqp://blog:密码@localhost:5672/   # 生产环境主机名改为 compose 服务名 rabbitmq
LLM_API_KEY=智谱 API Key
AUTH_JWT_SECRET=                                  # openssl rand -hex 32 生成
AUTH_ADMIN_PASSWORD=管理员密码
RAG_EMBEDDING_API_KEY=SiliconFlow API Key
# RAG_CHAT_API_KEY=        # 留空复用 LLM_API_KEY（glm-4-flash 免费档不扣余额）
# EMAIL_USERNAME=          # 开启邮件通知后填：SMTP 登录账号
# EMAIL_PASSWORD=          # SMTP 授权码（非邮箱登录密码）
# TASK_PROXY=              # 本机 github 不通时填代理（如 http://127.0.0.1:7890），留空直连
# EMAIL_SITE_URL=          # 前台地址（生产填 https://域名），缺省 http://localhost:3000
