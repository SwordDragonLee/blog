# 生产环境私密配置模板：复制为 .env 放在 compose.prod.yml 同目录（本地演练放 docker/.env，服务器放 /opt/blog/.env）。
# .env 含真实密码与 API key：绝不提交 git、不截图；scp 上服务器后 chmod 600 .env。
#
# 该文件同时服务两类用途（同一个文件）：
#   1. compose 变量替换 —— 中间件容器初始化用（MYSQL_ROOT_PASSWORD / RABBITMQ_DEFAULT_* 等）
#   2. compose env_file —— 整体注入 server 容器进程环境，键名 = config.yaml 配置项点号换下划线大写
#
# 三处数据库密码必须一致：
#   MYSQL_PASSWORD = MYSQL_ROOT_PASSWORD（server 客户端用 root 登录）
#   REDIS_PASSWORD 同时供 redis 容器 --requirepass 与 server 客户端使用
#   RABBITMQ_URL 里的密码段 = RABBITMQ_DEFAULT_PASS

# ── 中间件初始化 ──
MYSQL_ROOT_PASSWORD=改成强密码
REDIS_PASSWORD=改成强密码
RABBITMQ_DEFAULT_USER=blog
RABBITMQ_DEFAULT_PASS=改成强密码

# ── server 容器（env_file 注入）──
MYSQL_PASSWORD=与 MYSQL_ROOT_PASSWORD 一致
RABBITMQ_URL=amqp://blog:改成强密码@rabbitmq:5672/   # 密码段与 RABBITMQ_DEFAULT_PASS 一致，主机名是 compose 服务名
LLM_API_KEY=智谱 API Key
AUTH_JWT_SECRET=openssl-rand-hex-32-生成
AUTH_ADMIN_PASSWORD=管理端强密码
RAG_EMBEDDING_API_KEY=SiliconFlow API Key
# RAG_CHAT_API_KEY=        # 留空复用 LLM_API_KEY
EMAIL_SITE_URL=https://<域名>     # 通知邮件里的文章链接前缀
# TASK_PROXY=              # 服务器直连 github 时好时坏，持续不通再配代理地址
# EMAIL_USERNAME=          # 开启邮件通知后填：SMTP 登录账号
# EMAIL_PASSWORD=          # SMTP 授权码
#
# 本机演练额外加一行（服务器上不需要）：
# SERVER_CONFIG_PATH=../server/config.yaml   # 直接挂仓库的 server/config.yaml，免去复制
